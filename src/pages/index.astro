---
import Layout from '@shared/layouts/Layout.astro';
import SectionHeading from '@features/homepage/SectionHeading.astro';

// import Button from '@shared/components/Button.astro';
// import HeroSVG from '@shared/icons/hero.svg';
// import MouseSVG from '@shared/icons/mouse.svg';
// import Nav from '@shared/components/Nav.astro';

const sectionGap = "8rem";
const bodyTextSize = "1.25rem";
---

<style define:vars={{ sectionGap, bodyTextSize }}>
	.hero {
		width: 100%;
		height: 75dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		text-align: center;
		position: relative;
		gap: 3rem;
		/* border-bottom: 1px solid black; */
		overflow: hidden;
		padding: 0 1rem;

		h1 {
			font-family: var(--font-body);
			font-size: 2.2rem;
			text-transform: uppercase;
			font-weight: 500;
			letter-spacing: 0.1em;
			
			@media (min-width: 900px) {
				font-size: 4rem;
			
			}
		}

	}
	.hero-subtitle {
		font-family: var(--font-heading);
		font-size: 1rem;
		text-transform: uppercase;
		letter-spacing: 0.8px;
	}
	.hero-copy {
		font-family: var(--font-body);
		font-size: var(--bodyTextSize);
		max-width: 400px;
		margin 0 auto;
	}

	.hero-icon-positioner {
		svg {
			height: auto;
			width: 100%;
			max-width: 928px;
			position: absolute;
			bottom: -4rem;
			left: 50%;
			transform: translate(-50%, 0);
		}
	}

	.mouse-icon-positioner {
		display: none;

		@media(min-width: 1280px) {
			display: block;
		}
		svg {
			position: absolute;
			top: -12rem;
			right: 4rem;
		}
	}

	.space-children {
		position: relative;
	}

	.space-children > *  {
		margin-top: var(--sectionGap);
	}

	.article-wrapper {
		position: relative;
		max-width: 856px;
		margin: 0 auto;
		padding: 5rem 0;
		/* border-bottom: 1px solid black; */

		@media (min-width: 768px) {
			padding: 5rem 3.5rem 8rem;
		}

		p {
			font-size: var(--bodyTextSize);
			line-height: 1.67;
			text-wrap: pretty;
		}

		> p + p {
			margin-top: 2rem;
		}
	}

	.section-content {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 0 1rem;
	}

	.cta-positioner {
		button {
			width: max-content;
			position: absolute;
			bottom: 0;
			left: 0;
			right: 0;
			transform: translateX(50%);
		}
	}

	#who-am-i {
		padding-bottom: 7rem;
		h2 {
			text-align: center;
			font-size: var(--bodyTextSize);
			letter-spacing: 0.8px;
			text-transform: uppercase;
			font-weight: 400;
		}
	}
</style>

<Layout showFooter={true}>
	<!-- <Nav /> -->
	<div class="hero">
		<header>
			<p class="hero-subtitle">Web development & design</p>
			<h1>
				Kieran Roberts
			</h1>
		</header>
		<p class="hero-copy">
			Former Full-Stack Developer and current <strong>Brand Web Developer</strong> at <strong>Tines</strong>.
		</p>
		<!-- <div class="hero-icon-positioner">
			<HeroSVG />
		</div> -->
	</div>

	<div class="space-children">
		<!-- <div class="mouse-icon-positioner">
			<MouseSVG />
		</div> -->
		<section id="who-am-i">
			<div class="section-content">
				<h2>Who am I?</h2>
				<div class="article-wrapper">
					<p>I am a problem solver with a passion for the creative on the web. My 5+ of years experience working in Frontend and Full Stack enginnering has given me the opportunity to work in both product-focused engineering, and frontend & design heavy brand and marketing roles.
						
					<p>Today, I am fortunate to be able to take my ideas all the way from conception, through design, and finally implementation. I dabble in UI/UX design using the latest in web design, building wireframes and mockups for web properties.</p>
					<p>I am in my element when writing code, with modern web frameworks and tools such as React, TypeScript, Astro, and more. These days it's hard not to be AI curious as well, and I like to stay up to date with the latest tooling possibilities here.</p>
					<p>Occasionally I like to write, and share web development related topics and tips through my <a href="/blog">blog</a>.</p>
				</div>
			</div>
		</section>

		<section id="lets-talk">
			<div class="section-content">
				<SectionHeading alignment="center" title="Website redesign in progress" copy="" />
			</div>
		</section>
	</div>
</Layout>
