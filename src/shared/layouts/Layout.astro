---
import type { ComponentProps } from 'astro/types';

import SEO from '@shared/components/SEO.astro';
import Footer from '@shared/components/Footer.astro';
import Nav from '@shared/components/Nav.astro';
import { DEFAULT_SEO_TITLE, DEFAULT_SEO_DESCRIPTION } from '@config/consts';

import '../styles/main.css';

type Props = ComponentProps<typeof SEO> & {
	showFooter?: boolean;
};

const DEFAULT_TITLE = DEFAULT_SEO_TITLE;
const DEFAULT_DESCRIPTION = DEFAULT_SEO_DESCRIPTION;

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	ogImage,
	// showFooter = true,
	isPostPage = false,
} = Astro.props;
---

<style>
	#main {
		position: relative;
	}
</style>

<html lang="en">
	<SEO {title} {description} {ogImage} {isPostPage} />
	<body>
		<header>
			<Nav />
		</header>
		<main id="main">
			<slot />
		</main>
		<Footer />
	</body>
</html>
