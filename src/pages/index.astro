---
import Layout from '@shared/layouts/Layout.astro';
---

<style>
	.hero-placeholder {
		width: 100%;
		height: 100dvh;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		background-color: #f0f0f0;
		color: #000;
		font-size: 2rem;
		font-weight: 500;
		text-align: center;

		h1 {
			font-size: 1em;
		}

		p {
			font-size: 0.6em;
		}
	}
</style>

<Layout showFooter={true}>
	<div class="hero-placeholder">
		<h1>
			kieranroberts.dev
		</h1>
		<p>
			Undergoing a design refresh, more to come soon...
		</p>
	</div>
</Layout>
