<style>
	nav {
		display: flex;
		justify-content: space-between;
		align-items: center;
		padding: 1.5rem 1rem;

		@media (min-width: 768px) {
			padding: 2rem 4rem;
		}

		div {
			display: flex;
			gap: 2.5rem;
		}

		a {
			text-decoration: none;
			color: inherit;
			font-family: var(--font-heading);
			font-size: 0.8rem;
			font-weight: 500;
			text-transform: uppercase;

			&:hover {
				color: #4f5052;
			}
		}

		p {
			display: none;
			font-size: 0.9rem;

			@media (min-width: 768px) {
				display: block;
			}
		}
	}
</style>

<nav>
	<div>
		<a href="/">Home</a>
		<a href="/blog">Blog</a>
	</div>
	<p>Website redesign in progress</p>
</nav>
